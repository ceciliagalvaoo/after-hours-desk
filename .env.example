# Non-secret values only. Every secret (RPC URL, Etherscan API key, and the
# deploy/signing private key) lives in the Hardhat keystore instead — never
# in this file, never committed:
#   npx hardhat keystore set --dev SEPOLIA_RPC_URL
#   npx hardhat keystore set --dev ETHERSCAN_API_KEY
#   npx hardhat keystore set --dev DESK_OWNER_PRIVATE_KEY

# Public address of the signer above (not sensitive, just the corresponding
# address — useful for scripts/UI without touching the keystore).
DESK_OWNER_ADDRESS=

# Filled in during Phase 1 (cToken) — see deployments/sepolia.json, the
# canonical machine-readable source the frontend should read from instead of
# hardcoding addresses. Mirrored here only for convenience/manual reference.
# `ERC20ToERC7984Wrapper` (used as ConfidentialUSDC's base contract) is
# confirmed to be the REAL contract name/path exported by
# @iexec-nox/nox-confidential-contracts@0.2.2 (not the hypothetical name this
# note originally flagged for verification) — see contracts/ConfidentialUSDC.sol.
# MOCK_USDC_ADDRESS=        # MockUSDC (our own test ERC-20, 6 decimals) on Sepolia
# CUSDC_ADDRESS=            # ConfidentialUSDC (ERC20ToERC7984Wrapper) on Sepolia

# Filled in during Phase 2+ once contracts are deployed:
# AFTER_HOURS_DESK_ADDRESS=  # AfterHoursDesk.sol deployment
# VIEWER_REGISTRY_ADDRESS=   # ViewerRegistry.sol deployment
# UNISWAP_POOL_ADDRESS=      # public Sepolia Uniswap pool used for price reference
# PRICE_ORACLE_ADDRESS=      # UniswapV3PriceReader.sol deployment
# COMPLIANCE_VIEWER_ADDRESS= # auditor address granted viewer rights over all fills

# Filled in during Phase 5 (frontend) — a second funded Sepolia signer so the
# demo/video can show buyer and seller as genuinely distinct wallets. Only
# the public address goes here; its private key stays in the user's own
# MetaMask, never in this repo.
# SECOND_TRADER_ADDRESS=
